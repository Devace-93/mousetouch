        "axis": "auto",
        # compositor_natural_scroll absent = auto
    },
    "pinch": {"enabled": True, "fingers": 2, "sensitivity": 1.5, "activation_mm": 3.0},
    "scroll": {"direction_debounce": True, "debounce_units": 40, "mode": "smooth", "speed": 1.0,
               "acceleration": 0.5, "momentum": True, "momentum_decay": 0.998},
    "taps": {"tap_max_ms": 400, "tap_max_mm": 15.0, "tap_max_lift_speed": 80.0, "double_tap_ms": 500},
    "gesture": [
        {"kind": "double_tap", "fingers": 2, "enabled": True, "action": {"type": "workspaces"}},
        {"kind": "tap", "fingers": 3, "enabled": True, "action": {"type": "apps"}},
    ],
}


def KINDS():
    return [("swipe", _("Swipe")), ("tap", _("Tap")), ("double_tap", _("Double tap"))]


def DIRS():
    return [("left", _("Left")), ("right", _("Right")), ("up", _("Up")), ("down", _("Down"))]


def ACTIONS():
    return [("workspaces", _("Workspaces overview (auto)")), ("apps", _("App library (auto)")),
            ("key", _("Keyboard shortcut")), ("toggle", _("Toggle two shortcuts")), ("cycle", _("Cycle through shortcuts")),
            ("button", _("Mouse button")), ("command", _("Run command"))]


# Actions whose shortcut the daemon reads from the desktop's own settings.
DESKTOP_ACTIONS = ("workspaces", "apps")
_DESKTOP_CACHE: dict = {}


def desktop_settings() -> dict:
    """What the daemon detected (`mousetouch desktop`): swipe fingers, natural
    scrolling and the workspaces/apps shortcuts. Empty when it cannot be run."""
    if "value" not in _DESKTOP_CACHE:
        _DESKTOP_CACHE["value"] = {}
        exe = mousetouch_binary()
        if exe:
            try:
                out = subprocess.run([exe, "desktop"], capture_output=True, text=True, timeout=5).stdout
                _DESKTOP_CACHE["value"] = json.loads(out)
            except (OSError, subprocess.TimeoutExpired, ValueError):
                pass
    return _DESKTOP_CACHE["value"]


def effective_axis(cfg_axis: str) -> str:
    """The axis swipes are replayed on: the configured one, or for "auto"
    what the daemon detected (a daemon before 0.1.13 does not say)."""
    if cfg_axis != "auto":
        return cfg_axis
    return desktop_settings().get("workspace_axis") or "horizontal"


def axis_label(axis: str) -> str:
    return {"horizontal": _("Horizontal"), "vertical": _("Vertical"), "both": _("Both")}.get(axis, axis)


def direction_hint(axis: str) -> str:
    """What "Natural" means on the axis in use."""
    if axis == "vertical":
        return _("Natural: swipe up to go to the next workspace (macOS style)")
    if axis == "both":
        return _("Natural: content follows your fingers (macOS style)")
    return _("Natural: swipe left to go to the next workspace (macOS style)")


def axis_hint() -> str:
    detected = desktop_settings().get("workspace_axis")
    return _("Direction your desktop switches workspaces in. Auto-detect follows the desktop (now: {axis}). Both: lock "
             "to the first direction and let the desktop decide (GNOME, KDE: vertical = overview)").format(
        axis=axis_label(detected) if detected else "?")


def desktop_action_hint(t: str) -> str:
    combo = desktop_settings().get({"workspaces": "workspaces_combo", "apps": "apps_combo"}[t], "?")
    return _("Follows the shortcut in your desktop settings (now {combo})").format(combo=combo)


def ACTION_HINT(t):
    return {
        "key": _("e.g. super+w, ctrl+alt+right, or a sequence: ctrl+equal,ctrl+equal"),
        "toggle": _("First trigger (on), e.g. ctrl+kpplus,ctrl+kpplus,ctrl+kpplus"),
        "cycle": _("Steps separated by ; e.g. ctrl+kpplus,ctrl+kpplus ; ctrl+kpplus ; ctrl+0"),
        "button": _("left, right or middle"),
        "command": _("shell command, e.g. notify-send hi"),
    }[t]


