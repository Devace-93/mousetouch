# Format version written here and by the daemon (src/config.rs CONFIG_VERSION).
CONFIG_VERSION = 2


def load_config() -> dict:
    cfg = {k: (dict(v) if isinstance(v, dict) else [dict(g) for g in v]) for k, v in DEFAULTS.items()}
    try:
        with open(CONFIG_PATH, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        return cfg
    for section in ("general", "workspace_swipe", "pinch", "scroll", "taps"):
        if isinstance(data.get(section), dict):
            cfg[section].update(data[section])
    if isinstance(data.get("gesture"), list):
        cfg["gesture"] = [dict(g) for g in data["gesture"]]
    # Same migration as the daemon's config::migrate: up to 0.1.12 every
    # file got axis = "horizontal" (no version key), the old default.
    if data.get("version", 0) < CONFIG_VERSION and cfg["workspace_swipe"].get("axis") == "horizontal":
        cfg["workspace_swipe"]["axis"] = "auto"
    return cfg


def _toml_value(v) -> str:
    if isinstance(v, list):
        return "[" + ", ".join(_toml_value(x) for x in v) + "]"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v) if isinstance(v, float) else str(v)
    s = str(v).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{s}"'


def dump_config(cfg: dict) -> str:
    out = [
        "# mousetouch configuration",
        "# Edit by hand or with `mousetouch-settings`. The daemon reloads on save.",
        "",
        f"version = {CONFIG_VERSION}",
        "",
    ]
    if not cfg["gesture"]:
        # A file without the key gets the daemon's default gestures back, so
        # an empty list has to be written out; a top-level key must come
        # before the first [section].
        out.append("# No gestures. Delete this line to get the default ones back.")
        out.append("gesture = []")
        out.append("")
    for section in ("general", "workspace_swipe", "pinch", "scroll", "taps"):
        out.append(f"[{section}]")
        for k, v in cfg[section].items():
            if v is None:
                continue
            out.append(f"{k} = {_toml_value(v)}")
        out.append("")
    for g in cfg["gesture"]:
        out.append("[[gesture]]")
        out.append(f"kind = {_toml_value(g['kind'])}")
        out.append(f"fingers = {int(g['fingers'])}")
        if g["kind"] == "swipe" and g.get("direction"):
            out.append(f"direction = {_toml_value(g['direction'])}")
        if g.get("app"):
            out.append(f"app = {_toml_value(g['app'])}")
        out.append(f"enabled = {_toml_value(bool(g.get('enabled', True)))}")
        out.append("")
        out.append("[gesture.action]")
        for k, v in g["action"].items():
            out.append(f"{k} = {_toml_value(v)}")
        out.append("")
    return "\n".join(out)


def save_config(cfg: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_PATH.with_suffix(".toml.tmp")
    tmp.write_text(dump_config(cfg))
    tmp.replace(CONFIG_PATH)


def describe_action(a: dict) -> str:
    t = a.get("type")
    if t in DESKTOP_ACTIONS:
        return dict(ACTIONS())[t]
    if t == "key":
        return _("Shortcut: {value}").format(value=a.get("combo", ""))
    if t == "toggle":
        return _("Toggle: {on}  ⇄  {off}").format(on=a.get("on", ""), off=a.get("off", ""))
    if t == "cycle":
        return _("Cycle: {steps}").format(steps="  →  ".join(a.get("steps", [])))
    if t == "button":
        return _("Click: {button}").format(button=a.get("button", ""))
    if t == "command":
        return _("Run: {command}").format(command=a.get("command", ""))
    return str(a)


