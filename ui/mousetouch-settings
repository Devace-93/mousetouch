def load_ui_prefs() -> dict:
    prefs = {"theme": "system", "language": "system"}
    try:
        with open(UI_PREFS_PATH, "rb") as f:
            data = tomllib.load(f)
    except (FileNotFoundError, tomllib.TOMLDecodeError):
        return prefs
    if data.get("theme") in THEMES:
        prefs["theme"] = data["theme"]
    lang = data.get("language")
    if lang == "system" or lang in LANG_CODES:
        prefs["language"] = lang
    return prefs


def save_ui_prefs(prefs: dict) -> None:
    UI_PREFS_PATH.parent.mkdir(parents=True, exist_ok=True)
    body = (
        "# mousetouch settings app preferences (not read by the daemon)\n"
        f'theme = "{prefs["theme"]}"        # system, light or dark\n'
        f'language = "{prefs["language"]}"  # system or a locale code like es-MX\n'
    )
    tmp = UI_PREFS_PATH.with_suffix(".toml.tmp")
    tmp.write_text(body)
    tmp.replace(UI_PREFS_PATH)


def system_lang() -> str:
    """The desktop language mapped onto our locale list ('es_MX.UTF-8' -> 'es-MX')."""
    raw = ""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var):
            raw = os.environ[var]
            break
    if not raw:
        try:
            raw = locale.getlocale()[0] or ""
        except ValueError:
            raw = ""
    raw = raw.split(".")[0].split("@")[0].replace("_", "-")
    if raw in LANG_CODES:
        return raw
    base = raw[:2].lower()
    for code in LANG_CODES:
        if code.startswith(base):
            return code
    return "en-US"


PREFS = load_ui_prefs()
LANG = system_lang() if PREFS["language"] == "system" else PREFS["language"]


def _(text: str) -> str:
    base = LANG[:2]
    return CATALOG.get(base, {}).get(text) or text


def apply_theme(theme: str) -> None:
    sm = Adw.StyleManager.get_default()
    sm.set_color_scheme({
        "light": Adw.ColorScheme.FORCE_LIGHT,
        "dark": Adw.ColorScheme.FORCE_DARK,
    }.get(theme, Adw.ColorScheme.DEFAULT))


