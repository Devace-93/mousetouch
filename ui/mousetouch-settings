def combo_row(title, subtitle, options, current, on_change, searchable=False):
    row = Adw.ComboRow(title=title, subtitle=subtitle or "")
    model = Gtk.StringList.new([label for _k, label in options])
    row.set_model(model)
    if searchable:
        row.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        row.set_enable_search(True)
    keys = [k for k, _l in options]
    row.set_selected(keys.index(current) if current in keys else 0)
    row.connect("notify::selected", lambda r, _p: on_change(keys[r.get_selected()]))
    return row


def spin_row(title, subtitle, value, lo, hi, step, digits, on_change):
    adj = Gtk.Adjustment(value=value, lower=lo, upper=hi, step_increment=step, page_increment=step * 10)
    row = Adw.SpinRow(title=title, subtitle=subtitle or "", adjustment=adj, digits=digits)
    row.connect("notify::value", lambda r, _p: on_change(round(r.get_value(), digits) if digits else int(r.get_value())))
    return row


def switch_row(title, subtitle, value, on_change):
    row = Adw.SwitchRow(title=title, subtitle=subtitle or "")
    row.set_active(bool(value))
    row.connect("notify::active", lambda r, _p: on_change(r.get_active()))
    return row


class GestureDialog(Adw.Dialog):
    """Add or edit one discrete gesture rule."""

    def __init__(self, gesture: dict | None, on_done):
        super().__init__(title=_("Gesture"), content_width=420)
        self.g = dict(gesture) if gesture else {"kind": "tap", "fingers": 3, "enabled": True, "action": {"type": "key", "combo": ""}}
        self.g["action"] = dict(self.g["action"])
        self.on_done = on_done

        tb = Adw.ToolbarView()
        header = Adw.HeaderBar()
        cancel = Gtk.Button(label=_("Cancel"))
        cancel.connect("clicked", lambda *_a: self.close())
        save = Gtk.Button(label=_("Save"), css_classes=["suggested-action"])
        save.connect("clicked", self._save)
        header.pack_start(cancel)
        header.pack_end(save)
        header.set_show_end_title_buttons(False)
        header.set_show_start_title_buttons(False)
        tb.add_top_bar(header)

        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup(title=_("Trigger"))
        grp.add(combo_row(_("Type"), None, KINDS(), self.g["kind"], self._set_kind))
        grp.add(spin_row(_("Fingers"), None, int(self.g["fingers"]), 1, 5, 1, 0, lambda v: self.g.__setitem__("fingers", v)))
        self.dir_row = combo_row(_("Direction"), _("Only for swipes"), DIRS(), self.g.get("direction") or "left",
                                 lambda v: self.g.__setitem__("direction", v))
        self.dir_row.set_visible(self.g["kind"] == "swipe")
        grp.add(self.dir_row)
        page.add(grp)

        grp = Adw.PreferencesGroup(title=_("Action"))
        t = self.g["action"]["type"]
        grp.add(combo_row(_("Do"), None, ACTIONS(), t, self._set_action_type))
        self.auto_row = Adw.ActionRow(title=_("Shortcut"), subtitle=desktop_action_hint(t if t in DESKTOP_ACTIONS else "workspaces"))
        self.auto_row.set_visible(t in DESKTOP_ACTIONS)
        grp.add(self.auto_row)
        self.value_row = Adw.EntryRow(title=ACTION_HINT(t) if t not in DESKTOP_ACTIONS else "")
        self.value_row.set_text(self._action_value())
        self.value_row.set_visible(t not in DESKTOP_ACTIONS)
        grp.add(self.value_row)
        self.off_row = Adw.EntryRow(title=_("Second trigger (off), e.g. ctrl+0"))
        self.off_row.set_text(self.g["action"].get("off", ""))
        self.off_row.set_visible(self.g["action"]["type"] == "toggle")
        grp.add(self.off_row)
        page.add(grp)

        grp = Adw.PreferencesGroup(title=_("Scope"),
                                   description=_("Leave empty for every app. Otherwise the rule only fires when the focused window's app id contains this text (e.g. firefox). Needs COSMIC, KDE, Sway or Hyprland."))
        self.app_row = Adw.EntryRow(title=_("Only in app"))
        self.app_row.set_text(self.g.get("app") or "")
        grp.add(self.app_row)
        page.add(grp)
        tb.set_content(page)
        self.set_child(tb)

    def _action_value(self):
        a = self.g["action"]
        if a.get("type") == "cycle":
            return " ; ".join(a.get("steps", []))
        return a.get("combo") or a.get("on") or a.get("button") or a.get("command") or ""

    def _set_kind(self, k):
        self.g["kind"] = k
        self.dir_row.set_visible(k == "swipe")
        if k == "swipe" and not self.g.get("direction"):
            self.g["direction"] = "left"

    def _set_action_type(self, t):
        self.g["action"] = {"type": t}
        auto = t in DESKTOP_ACTIONS
        self.auto_row.set_visible(auto)
        if auto:
            self.auto_row.set_subtitle(desktop_action_hint(t))
        else:
            self.value_row.set_title(ACTION_HINT(t))
        self.value_row.set_visible(not auto)
        self.off_row.set_visible(t == "toggle")

    def _save(self, *_a):
        t = self.g["action"]["type"]
        if t in DESKTOP_ACTIONS:
            self.g["action"] = {"type": t}
        else:
            key = {"key": "combo", "toggle": "on", "cycle": "steps", "button": "button", "command": "command"}[t]
            value = self.value_row.get_text().strip()
            if not value:
                self.value_row.add_css_class("error")
                return
            if t == "cycle":
                value = [p.strip() for p in value.split(";") if p.strip()]
            self.g["action"] = {"type": t, key: value}
        if t == "toggle":
            off = self.off_row.get_text().strip()
            if not off:
                self.off_row.add_css_class("error")
                return
            self.g["action"]["off"] = off
        if self.g["kind"] != "swipe":
            self.g.pop("direction", None)
        app = self.app_row.get_text().strip()
        if app:
            self.g["app"] = app
        else:
            self.g.pop("app", None)
        self.on_done(self.g)
        self.close()


# ---------------------------------------------------------------------------
# Live view. The daemon grabs the mouse, so it is the only thing that can see
# the fingers; it republishes them on $XDG_RUNTIME_DIR/mousetouch.sock as
# JSON lines (see src/monitor.rs). One EventClient feeds every view.
# ---------------------------------------------------------------------------

def socket_path() -> Path:
    run = os.environ.get("XDG_RUNTIME_DIR")
    if run and os.path.isabs(run):
        return Path(run) / "mousetouch.sock"
    return Path(f"/tmp/mousetouch-{os.getuid()}.sock")


class EventClient:
    """Connection to the daemon's event stream; retries every 1.5 s while the
    daemon is away. Listeners get each decoded event plus synthetic
    {"t": "connected"} / {"t": "disconnected"} markers.

    Events of a mouse carry "dev", a number the daemon gives each attached
    mouse; a daemon older than that field sends none (key None here)."""

    def __init__(self):
        self.listeners = []
        self.connected = False
        # Attached mice: dev -> their "device" event, in the order they
        # arrived. The daemon replays them only to a new socket connection
        # and every view shares this one, so views created later (the
        # detached Live window) get them from here instead.
        self.devices: dict = {}
        # dev -> palette slot, kept while the mouse stays attached so its
        # colours do not change when another one comes or goes.
        self.slots: dict = {}
        # Last known name of every dev seen, also after it went away.
        self.names: dict = {}
        self._sock = None
        self._buf = b""
        GLib.timeout_add(1500, self._try_connect)
        self._try_connect()

    def add_listener(self, fn):
        if fn not in self.listeners:
            self.listeners.append(fn)
            for ev in list(self.devices.values()):
                fn(ev)

    def remove_listener(self, fn):
        if fn in self.listeners:
            self.listeners.remove(fn)

    def palette(self, dev) -> list:
        return FINGER_PALETTES[self.slots.get(dev, 0) % len(FINGER_PALETTES)]

    def label(self, dev) -> str:
        """The mouse's name, with its number when two share a name."""
        name = self.names.get(dev) or self.devices.get(dev, {}).get("name") or _("Magic Mouse")
        twins = [d for d, n in self.names.items() if n == name and d in self.devices]
        return f"{name} #{dev}" if dev is not None and len(twins) > 1 else name

    def _emit(self, ev):
        t = ev.get("t")
        dev = ev.get("dev")
        if t == "desktop" and isinstance(ev.get("settings"), dict):
            # The daemon re-sends this whenever the desktop changes (e.g.
            # COSMIC switched to vertical workspaces).
            _DESKTOP_CACHE["value"] = ev["settings"]
        if t == "device":
            self.devices[dev] = ev
            self.names[dev] = ev.get("name", "")
            if dev not in self.slots:
                slot = 0
                while slot in self.slots.values():
                    slot += 1
                self.slots[dev] = slot
        elif t == "device_lost":
            self.devices.pop(dev, None)
            self.slots.pop(dev, None)
        elif t == "disconnected":
            self.devices.clear()
            self.slots.clear()
        for fn in list(self.listeners):
            fn(ev)

    def _try_connect(self):
        if self._sock is not None:
            return True
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.setblocking(False)
        try:
            s.connect(str(socket_path()))
        except OSError:
            s.close()
            return True
        self._sock = s
        self.connected = True
        GLib.io_add_watch(s.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._on_readable)
        self._emit({"t": "connected"})
        return True

    def _on_readable(self, _fd, cond):
        data = b""
        if cond & GLib.IO_IN:
            try:
                data = self._sock.recv(65536)
            except BlockingIOError:
                return True
            except OSError:
                data = b""
        if not data:
            self._sock.close()
            self._sock = None
            self._buf = b""
            self.connected = False
            self._emit({"t": "disconnected"})
            return False
        self._buf += data
        *lines, self._buf = self._buf.split(b"\n")
        for ln in lines:
            if ln:
                try:
                    self._emit(json.loads(ln))
                except ValueError:
                    pass
        return True


class DeviceChooser(Gtk.DropDown):
    """Which mouse the live view (and log) follow. Lists every attached mouse
    and, when there are several, "All mice" first; `on_change` gets the dev
    number, or None for all of them."""

    def __init__(self, client: EventClient, on_change):
        super().__init__(valign=Gtk.Align.CENTER)
        self.client = client
        self.on_change = on_change
        self.keys = []
        self._rebuilding = False
        self.connect("notify::selected", self._selected)
        self.connect("map", lambda *_a: client.add_listener(self.on_event))
        self.connect("unmap", lambda *_a: client.remove_listener(self.on_event))
        self._rebuild(None)

    def current(self):
        i = self.get_selected()
        return self.keys[i] if 0 <= i < len(self.keys) else None

    def on_event(self, ev: dict):
        if ev.get("t") in ("device", "device_lost", "disconnected"):
            self._rebuild(self.current())

    def _rebuild(self, keep):
        devs = list(self.client.devices)
        if not devs:
            keys, labels = [None], [_("No Magic Mouse connected")]
        elif len(devs) == 1:
            keys, labels = devs, [self.client.label(devs[0])]
        else:
            keys, labels = [None] + devs, [_("All mice")] + [self.client.label(d) for d in devs]
        self._rebuilding = True
        self.keys = keys
        self.set_model(Gtk.StringList.new(labels))
        self.set_selected(keys.index(keep) if keep in keys else 0)
        self.set_sensitive(bool(devs))
        self._rebuilding = False
        self.on_change(self.current())

    def _selected(self, *_a):
        if not self._rebuilding:
            self.on_change(self.current())

DIR_ARROWS = {"left": "←", "right": "→", "up": "↑", "down": "↓"}
# Finger colours: one palette per mouse shown at the same time (first colour
# doubles as that mouse's accent for arrows, gauges and badges).
FINGER_PALETTES = [
    [(0.21, 0.52, 0.89), (0.18, 0.69, 0.42), (0.96, 0.47, 0.0), (0.72, 0.26, 0.76), (0.88, 0.16, 0.20)],  # cool, blue first
    [(0.86, 0.22, 0.45), (0.95, 0.65, 0.10), (0.10, 0.65, 0.65), (0.55, 0.40, 0.90), (0.45, 0.60, 0.15)],  # warm, pink first
]
FINGER_COLORS = FINGER_PALETTES[0]
ACCENT = FINGER_COLORS[0]
# Magic Mouse 2 footprint (mm); only the outline's proportions matter.
MOUSE_W_MM, MOUSE_L_MM = 57.0, 113.0


def fingers_text(n: int) -> str:
    return _("1 finger") if n == 1 else _("{n} fingers").format(n=n)


def describe_rule(ev: dict) -> str:
    kind = {"swipe": _("Swipe"), "tap": _("Tap"), "double_tap": _("Double tap")}.get(ev.get("kind"), ev.get("kind", ""))
    s = f"{kind} · {fingers_text(ev.get('fingers', 0))}"
    if ev.get("dir"):
        s += " " + DIR_ARROWS.get(ev["dir"], ev["dir"])
    s += " → " + (ev.get("action") or _("no rule"))
    if ev.get("app"):
        s += f" ({ev['app']})"
    return s


def describe_live_gesture(ev: dict) -> str:
    name = _("Workspace swipe") if ev.get("gesture") == "workspace_swipe" else _("Pinch")
    s = f"{name} · {fingers_text(ev.get('fingers', 0))}"
    if ev.get("dir"):
        s += " " + DIR_ARROWS.get(ev["dir"], ev["dir"])
    return s


def describe_event(ev: dict) -> str | None:
    """Log line for an event, or None for the ones that are drawn only."""
    t = ev.get("t")
    if t == "rule":
        return describe_rule(ev)
    if t == "gesture_begin":
        return describe_live_gesture(ev)
    if t == "touch_end":
        n = ev.get("fingers", 0)
        if ev.get("tap"):
            return f"{_('Tap')} · {fingers_text(n)}"
        return f"{fingers_text(n)} · " + _("not a tap: {reason}").format(reason=_(ev.get("reason", "")))
    if t == "button":
        return f"{_('Click')}: {ev.get('button', '')} {'↓' if ev.get('down') else '↑'}"
    if t == "device":
        return _("Mouse attached: {name}").format(name=ev.get("name", ""))
    if t == "device_lost":
        return _("Mouse detached")
    if t == "connected":
        return _("Connected to the daemon")
    if t == "disconnected":
        return _("Daemon disconnected")
    return None


def draw_text(cr, text, x, y, size=11.0, color=(0, 0, 0), align="left", bold=False, alpha=1.0):
    layout = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription.from_string("Sans")
    fd.set_absolute_size(size * Pango.SCALE)
    if bold:
        fd.set_weight(Pango.Weight.BOLD)
    layout.set_font_description(fd)
    layout.set_text(text, -1)
    tw, th = layout.get_pixel_size()
    if align == "center":
        x, y = x - tw / 2, y - th / 2
    elif align == "right":
        x -= tw
    cr.set_source_rgba(*color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return tw, th


def rounded_rect(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw_arrow(cr, x1, y1, x2, y2, color, width=4.0, alpha=1.0):
    ang = math.atan2(y2 - y1, x2 - x1)
    head = max(8.0, width * 2.6)
    cr.set_source_rgba(*color, alpha)
    cr.set_line_width(width)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(x1, y1)
    cr.line_to(x2 - math.cos(ang) * head * 0.6, y2 - math.sin(ang) * head * 0.6)
    cr.stroke()
    cr.move_to(x2, y2)
    cr.line_to(x2 - head * math.cos(ang - 0.5), y2 - head * math.sin(ang - 0.5))
    cr.line_to(x2 - head * math.cos(ang + 0.5), y2 - head * math.sin(ang + 0.5))
    cr.close_path()
    cr.fill()


class DevState:
    """What one mouse is doing right now, as the live view tracks it."""

    def __init__(self):
        self.fingers = []
        self.trails = {}
        self.lifted = []
        self.state = "idle"
        self.pad = None
        self.scale = None
        self.scroll = {"dx": 0.0, "dy": 0.0, "t": 0.0}
        self.buttons = {}

    def animating(self, now: float) -> bool:
        return bool(self.fingers or self.lifted or now - self.scroll["t"] < 1.0 or any(self.buttons.values()))


class MouseView(Gtk.DrawingArea):
    """Top view of the mouse with the fingers on it, where they landed, the
    path they took, the gesture the daemon is replaying, scrolling and
    clicks. Follows one mouse (`filter` = its dev number) or all of them at
    once, each in its own colours. Listens only while mapped."""

    BADGE_S = 2.8
    TRAIL_S = 0.7

    def __init__(self, client: EventClient, compact: bool = False):
        super().__init__(hexpand=True, vexpand=True)
        self.set_content_height(240 if compact else 340)
        self.client = client
        self.compact = compact
        self.connected = client.connected
        self.devs: dict = {}  # dev -> DevState, every attached mouse
        self.filter = None  # dev to show, None for all
        self.badges = []
        self._tick = 0
        self.set_draw_func(self._draw)
        self.connect("map", lambda *_a: client.add_listener(self.on_event))
        self.connect("unmap", lambda *_a: client.remove_listener(self.on_event))

    def set_filter(self, dev):
        self.filter = dev
        self.queue_draw()

    def _shown(self) -> list:
        return [d for d in self.client.devices if self.filter is None or d == self.filter]

    # -- events ------------------------------------------------------------
    def on_event(self, ev: dict):
        t = ev.get("t")
        dev = ev.get("dev")
        now = time.monotonic()
        if t == "connected":
            self.connected = True
        elif t == "disconnected":
            self.connected = False
            self.devs = {}
            self.badges = []
        elif t == "device":
            self.devs.setdefault(dev, DevState())
        elif t == "device_lost":
            self.devs.pop(dev, None)
        elif t in ("frame", "gesture_begin", "rule", "touch_end", "scroll", "button"):
            st = self.devs.setdefault(dev, DevState())
            # A hidden mouse is still tracked, so switching to it shows its
            # fingers right away; only its badges are skipped.
            shown = self.filter is None or dev == self.filter
            if t == "frame":
                fingers = ev.get("fingers", [])
                if fingers:
                    ids = {f["id"] for f in fingers}
                    for f in fingers:
                        tr = st.trails.setdefault(f["id"], [])
                        tr.append((f["x"], f["y"], now))
                        del tr[:-150]
                    for k in [k for k in st.trails if k not in ids]:
                        del st.trails[k]
                else:
                    st.lifted = [(f["x"], f["y"], now) for f in st.fingers] + st.lifted
                    st.trails = {}
                st.fingers = fingers
                st.state = ev.get("state", "idle")
                st.pad = (ev["pad_dx"], ev["pad_dy"]) if "pad_dx" in ev else None
                st.scale = ev.get("scale")
            elif t == "gesture_begin" and shown:
                self._badge(dev, describe_live_gesture(ev), "accent")
            elif t == "rule" and shown:
                # Every 1-finger movement is checked against swipe rules; a miss
                # there is just normal mouse use, not worth a badge.
                if ev.get("matched") or ev.get("fingers", 0) > 1 or ev.get("kind") != "swipe":
                    self._badge(dev, describe_rule(ev), "accent" if ev.get("matched") else "muted")
            elif t == "touch_end" and shown:
                n = ev.get("fingers", 0)
                if ev.get("tap"):
                    self._badge(dev, f"{_('Tap')} · {fingers_text(n)}", "info")
                elif n > 1 and ev.get("reason"):
                    self._badge(dev, _("not a tap: {reason}").format(reason=_(ev["reason"])), "warn")
            elif t == "scroll":
                if now - st.scroll["t"] > 0.8:
                    st.scroll["dx"] = st.scroll["dy"] = 0.0
                st.scroll["dx"] += ev.get("dx", 0)
                st.scroll["dy"] += ev.get("dy", 0)
                st.scroll["t"] = now
            elif t == "button":
                st.buttons[ev.get("button", "")] = bool(ev.get("down"))
        self._animate()

    def _badge(self, dev, text: str, kind: str):
        self.badges.append({"text": text, "kind": kind, "t": time.monotonic(), "dev": dev})
        del self.badges[:-3]

    def _animating(self, now: float) -> bool:
        return bool(self.badges or any(st.animating(now) for st in self.devs.values()))

    def _animate(self):
        self.queue_draw()
        if not self._tick:
            self._tick = GLib.timeout_add(33, self._on_tick)

    def _on_tick(self):
        now = time.monotonic()
        self.badges = [b for b in self.badges if now - b["t"] < self.BADGE_S]
        for st in self.devs.values():
            st.lifted = [g for g in st.lifted if now - g[2] < 0.6]
        self.queue_draw()
        if self._animating(now):
            return True
        self._tick = 0
        return False

    # -- drawing -----------------------------------------------------------
    def _draw(self, _area, cr, w, h):
        dark = Adw.StyleManager.get_default().get_dark()
        fg = (0.93, 0.93, 0.93) if dark else (0.13, 0.13, 0.13)
        muted = (0.62, 0.62, 0.64) if dark else (0.47, 0.47, 0.48)
        body = (0.20, 0.20, 0.21) if dark else (0.975, 0.975, 0.97)
        edge = (0.45, 0.45, 0.47) if dark else (0.68, 0.68, 0.67)
        now = time.monotonic()
        font = 10.0 if self.compact else 11.5
        shown = self._shown()
        mixed = len(shown) > 1

        # Header: status, or one legend entry (colour dot + name) per mouse
        # shown; finger count on the right.
        if not self.connected:
            draw_text(cr, _("Daemon not running"), 12, 8, font, muted, bold=True)
            draw_text(cr, _("Start the background service (mousetouch.service)"), 12, 8 + font * 1.5, font * 0.9, muted)
        elif not shown:
            draw_text(cr, _("No Magic Mouse connected"), 12, 8, font, muted, bold=True)
        else:
            x = 12
            for dev in shown:
                dot = self.client.palette(dev)[0]
                cr.arc(x + font * 0.4, 8 + font * 0.75, font * 0.4, 0, 2 * math.pi)
                cr.set_source_rgb(*dot)
                cr.fill()
                tw, _th = draw_text(cr, self.client.label(dev), x + font * 1.2, 8, font, fg, bold=True)
                x += font * 1.2 + tw + font * 1.4
            if not mixed:
                draw_text(cr, self.client.devices[shown[0]].get("source", ""), 12, 8 + font * 1.5, font * 0.9, muted)
        fingers_total = sum(len(self.devs[d].fingers) for d in shown if d in self.devs)
        if fingers_total:
            states = [self.devs[d].state for d in shown if d in self.devs and self.devs[d].fingers]
            state = next((s for s in states if s in ("workspace", "pinch")), None)
            state = {"workspace": _("Workspace swipe"), "pinch": _("Pinch")}.get(state)
            right = fingers_text(fingers_total) + (f" · {state}" if state else "")
            draw_text(cr, right, w - 12, 8, font, fg, align="right", bold=True)
        elif shown and not self.badges:
            draw_text(cr, _("Waiting for a touch…"), w - 12, 8, font * 0.9, muted, align="right")

        # Outline, leaving room for the header and the scroll gauge.
        top = 8 + font * 3.2
        gauge = 64
        s = min((h - top - 18) / MOUSE_L_MM, (w - 2 * gauge) / MOUSE_W_MM)
        mw, ml = MOUSE_W_MM * s, MOUSE_L_MM * s
        mx, my = (w - mw) / 2, top + (h - top - 14 - ml) / 2
        rounded_rect(cr, mx, my, mw, ml, mw * 0.46)
        cr.set_source_rgb(*body)
        cr.fill_preserve()
        cr.set_source_rgb(*edge)
        cr.set_line_width(1.5)
        cr.stroke()
        if not shown:
            cr.set_source_rgba(*muted, 0.25 if dark else 0.18)
            rounded_rect(cr, mx, my, mw, ml, mw * 0.46)
            cr.fill()

        inset = 3.0 * s
        r = max(8.0, 4.5 * s)  # a fingertip contact is roughly 9 mm across
        for i, dev in enumerate(shown):
            st = self.devs.get(dev)
            if st is None:
                continue
            pal = self.client.palette(dev)
            accent = pal[0]
            info = self.client.devices[dev]
            self._draw_mouse(cr, st, pal, accent, info, i, now, s, r, inset, mx, my, mw, ml, gauge, font, fg, muted)

        # Badges: recent discrete results, newest at the bottom; the mouse's
        # name in front when several are shown.
        by = h - 10
        for b in reversed(self.badges):
            age = now - b["t"]
            a = 1.0 if age < self.BADGE_S - 0.7 else max(0.0, (self.BADGE_S - age) / 0.7)
            accent = self.client.palette(b["dev"])[0]
            bg = {"accent": accent, "warn": (0.90, 0.45, 0.10), "muted": muted, "info": (0.36, 0.60, 0.46)}[b["kind"]]
            text = f"{self.client.label(b['dev'])} · {b['text']}" if mixed else b["text"]
            layout = PangoCairo.create_layout(cr)
            fd = Pango.FontDescription.from_string("Sans")
            fd.set_absolute_size(font * Pango.SCALE)
            fd.set_weight(Pango.Weight.BOLD)
            layout.set_font_description(fd)
            layout.set_text(text, -1)
            layout.set_width(int((w - 24) * Pango.SCALE))
            layout.set_ellipsize(Pango.EllipsizeMode.END)
            tw, th = layout.get_pixel_size()
            bh = th + 10
            rounded_rect(cr, 10, by - bh, tw + 18, bh, bh / 2)
            cr.set_source_rgba(*bg, 0.92 * a)
            cr.fill()
            cr.set_source_rgba(1, 1, 1, a)
            cr.move_to(19, by - bh + 5)
            PangoCairo.show_layout(cr, layout)
            by -= bh + 6

    def _draw_mouse(self, cr, st, pal, accent, info, idx, now, s, r, inset, mx, my, mw, ml, gauge, font, fg, muted):
        """One mouse's fingers, gesture, clicks and scrolling on the shared
        outline; `idx` offsets the scroll gauges so two mice do not overlap."""
        # Clicks light up the front half on the side pressed.
        for name, down in st.buttons.items():
            if not down:
                continue
            cr.save()
            rounded_rect(cr, mx, my, mw, ml, mw * 0.46)
            cr.clip()
            if name == "left":
                cr.rectangle(mx, my, mw / 2, ml * 0.42)
            elif name == "right":
                cr.rectangle(mx + mw / 2, my, mw / 2, ml * 0.42)
            else:
                cr.rectangle(mx + mw * 0.3, my, mw * 0.4, ml * 0.42)
            cr.set_source_rgba(*accent, 0.3)
            cr.fill()
            cr.restore()

        dev_w = info.get("w_mm") or 1.0
        dev_h = info.get("h_mm") or 1.0

        def to_px(x, y):
            return (
                mx + inset + (mw - 2 * inset) * min(1.0, max(0.0, x / dev_w)),
                my + inset + (ml - 2 * inset) * min(1.0, max(0.0, y / dev_h)),
            )

        # Ghosts of fingers that just lifted.
        for x, y, t0 in st.lifted:
            a = max(0.0, 1 - (now - t0) / 0.6)
            px, py = to_px(x, y)
            cr.arc(px, py, r * (1 + 0.8 * (1 - a)), 0, 2 * math.pi)
            cr.set_source_rgba(*muted, 0.45 * a)
            cr.set_line_width(2)
            cr.stroke()

        # Trails, landing points and fingers.
        for i, f in enumerate(st.fingers):
            col = pal[i % len(pal)]
            tr = st.trails.get(f["id"], [])
            if len(tr) > 1:
                cr.set_line_width(max(2.0, r * 0.5))
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                for (x1, y1, _t1), (x2, y2, t2) in zip(tr, tr[1:]):
                    age = now - t2
                    if age > self.TRAIL_S:
                        continue
                    cr.move_to(*to_px(x1, y1))
                    cr.line_to(*to_px(x2, y2))
                    cr.set_source_rgba(*col, 0.5 * (1 - age / self.TRAIL_S))
                    cr.stroke()
            x0, y0 = to_px(f["x0"], f["y0"])
            px, py = to_px(f["x"], f["y"])
            if math.hypot(px - x0, py - y0) > r * 0.8:
                cr.arc(x0, y0, r * 0.4, 0, 2 * math.pi)
                cr.set_source_rgba(*col, 0.85)
                cr.set_line_width(1.5)
                cr.stroke()
            cr.arc(px, py, r, 0, 2 * math.pi)
            cr.set_source_rgba(*col, 0.95)
            cr.fill_preserve()
            cr.set_source_rgba(1, 1, 1, 0.9)
            cr.set_line_width(2)
            cr.stroke()
            draw_text(cr, str(i + 1), px, py, r * 1.15, (1, 1, 1), align="center", bold=True)

        # Centroid and the continuous gesture being replayed.
        if len(st.fingers) >= 2:
            cx = sum(f["x"] for f in st.fingers) / len(st.fingers)
            cy = sum(f["y"] for f in st.fingers) / len(st.fingers)
            pcx, pcy = to_px(cx, cy)
            cr.set_source_rgba(*fg, 0.5)
            cr.set_line_width(1.2)
            cr.move_to(pcx - 6, pcy)
            cr.line_to(pcx + 6, pcy)
            cr.move_to(pcx, pcy - 6)
            cr.line_to(pcx, pcy + 6)
            cr.stroke()
            if st.state == "workspace" and st.pad:
                dx, dy = st.pad
                dist = math.hypot(dx, dy)
                if dist > 0.3:
                    ux, uy = dx / dist, dy / dist
                    length = min(ml * 0.42, 14 + dist * s)
                    draw_arrow(cr, pcx, pcy, pcx + ux * length, pcy + uy * length, accent, width=max(3.0, r * 0.4))
                    draw_text(cr, f"{dist:.0f} mm", pcx + ux * (length + 10), pcy + uy * (length + 10) - font / 2, font, fg,
                              align="right" if ux < 0 else "left", bold=True)
            elif st.state == "pinch" and st.scale:
                # One arrow beyond each finger, pointing away from the centroid
                # when the fingers spread and towards it when they close.
                out = st.scale >= 1.0
                reach = r * 2.2
                for f in st.fingers[:2]:
                    px, py = to_px(f["x"], f["y"])
                    d = math.hypot(px - pcx, py - pcy)
                    if d < 1:
                        continue
                    ux, uy = (px - pcx) / d, (py - pcy) / d
                    base = (px + ux * r * 1.3, py + uy * r * 1.3)
                    tip = (base[0] + ux * reach, base[1] + uy * reach)
                    if out:
                        draw_arrow(cr, *base, *tip, accent, width=max(3.0, r * 0.3))
                    else:
                        draw_arrow(cr, *tip, *base, accent, width=max(3.0, r * 0.3))
                draw_text(cr, f"×{st.scale:.2f}", pcx, pcy + r * 1.6, font, fg, align="center", bold=True)

        # Scroll gauge beside the mouse (vertical wheel) and below it
        # (horizontal), one lane per mouse shown.
        age = now - st.scroll["t"]
        if age < 1.0 and (st.scroll["dy"] or st.scroll["dx"]):
            a = 1.0 if age < 0.5 else 1 - (age - 0.5) / 0.5
            gx = mx + mw + gauge * 0.55 + idx * 16
            cr.set_source_rgba(*muted, 0.35 * a)
            cr.set_line_width(2)
            cr.move_to(gx, my + ml * 0.15)
            cr.line_to(gx, my + ml * 0.85)
            cr.stroke()
            notches = st.scroll["dy"] / 120.0
            if notches:
                # Positive wheel = away from the user = content up.
                length = min(ml * 0.33, 10 + abs(notches) * 14)
                gy = my + ml / 2
                draw_arrow(cr, gx, gy, gx, gy - math.copysign(length, notches), accent, width=3.5, alpha=a)
                draw_text(cr, f"{notches:+.1f}", gx, gy + math.copysign(length + 10, -notches) - font / 2, font, fg, align="center", alpha=a, bold=True)
            hnotches = st.scroll["dx"] / 120.0
            if hnotches:
                length = min(mw * 0.4, 10 + abs(hnotches) * 14)
                gy = my + ml + 8 + idx * 12
                draw_arrow(cr, mx + mw / 2, gy, mx + mw / 2 + math.copysign(length, hnotches), gy, accent, width=3.5, alpha=a)


class EventLog(Gtk.ScrolledWindow):
    """Newest-first list of what the daemon reported. Consecutive scroll
    events within half a second share one row."""

    MAX_ROWS = 120

    def __init__(self, client: EventClient):
        super().__init__(vexpand=True, min_content_height=150, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.client = client
        self.filter = None  # dev to show, None for all
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        self.set_child(self.list)
        self._scroll_row = None
        self._scroll_dev = None
        self._scroll_t = 0.0
        self._scroll_sum = [0.0, 0.0]
        self.connect("map", lambda *_a: client.add_listener(self.on_event))
        self.connect("unmap", lambda *_a: client.remove_listener(self.on_event))

    def set_filter(self, dev):
        self.filter = dev

    def _prefix(self, ev: dict) -> str:
        dev = ev.get("dev")
        if self.filter is None and dev is not None and len(self.client.devices) > 1:
            return self.client.label(dev) + " · "
        return ""

    def on_event(self, ev: dict):
        t = ev.get("t")
        dev = ev.get("dev")
        if t not in ("device", "device_lost", "connected", "disconnected") and self.filter is not None and dev != self.filter:
            return
        if t == "scroll":
            now = time.monotonic()
            if (self._scroll_row is None or now - self._scroll_t > 0.5 or dev != self._scroll_dev
                    or self.list.get_row_at_index(0) is not self._scroll_row):
                self._scroll_sum = [0.0, 0.0]
                self._scroll_row = self._add("")
                self._scroll_dev = dev
            self._scroll_t = now
            self._scroll_sum[0] += ev.get("dx", 0)
            self._scroll_sum[1] += ev.get("dy", 0)
            parts = []
            if self._scroll_sum[1]:
                parts.append(f"{'↑' if self._scroll_sum[1] > 0 else '↓'} {abs(self._scroll_sum[1]) / 120:.1f}")
            if self._scroll_sum[0]:
                parts.append(f"{'→' if self._scroll_sum[0] > 0 else '←'} {abs(self._scroll_sum[0]) / 120:.1f}")
            self._scroll_row.set_title(GLib.markup_escape_text(f"{self._prefix(ev)}{_('Scroll')} {' '.join(parts)}"))
            return
        text = describe_event(ev)
        if text:
            self._add(self._prefix(ev) + text if t not in ("device", "device_lost") else text)

    def _add(self, text: str) -> Adw.ActionRow:
        row = Adw.ActionRow(title=GLib.markup_escape_text(text), subtitle=time.strftime("%H:%M:%S"))
        self.list.prepend(row)
        extra = self.list.get_row_at_index(self.MAX_ROWS)
        if extra is not None:
            self.list.remove(extra)
        return row

    def clear(self):
        while (row := self.list.get_row_at_index(0)) is not None:
            self.list.remove(row)
        self._scroll_row = None


def mousetouch_binary() -> str | None:
    exe = shutil.which("mousetouch")
    if exe:
        return exe
    # Launched from a desktop entry the session PATH may lack the install
    # prefix (Homebrew, ~/.local, Nix): every packager puts both binaries in
    # the same bin dir, so look next to this script before giving up.
    here = Path(__file__).resolve()
    candidates = [
        here.parent / "mousetouch",
        here.parent.parent / "target" / "release" / "mousetouch",
        here.parent.parent / "target" / "debug" / "mousetouch",
        Path("/home/linuxbrew/.linuxbrew/bin/mousetouch"),
        Path.home() / ".linuxbrew" / "bin" / "mousetouch",
        Path.home() / ".local" / "bin" / "mousetouch",
        Path.home() / ".cargo" / "bin" / "mousetouch",
    ]
    for p in candidates:
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    return None


_VERSION_CACHE: dict = {}


def installed_version() -> str | None:
    """Version of the mousetouch binary on disk right now (`mousetouch
    --version`), re-read only when the file changes."""
    exe = mousetouch_binary()
    if not exe:
        return None
    try:
        st = os.stat(exe)
        key = (exe, st.st_dev, st.st_ino, st.st_mtime_ns, st.st_size)
    except OSError:
        return None
    if _VERSION_CACHE.get("key") != key:
        try:
            out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=3).stdout
            _VERSION_CACHE["version"] = out.strip().split()[-1] if out.strip() else None
        except Exception:  # noqa: BLE001
            _VERSION_CACHE["version"] = None
        _VERSION_CACHE["key"] = key
    return _VERSION_CACHE.get("version")


# The version installed when this process started: once the binary on disk
# reports another one, an upgrade happened under us.
STARTUP_VERSION = None


def device_state_text(d: dict) -> str:
    if d.get("state") == "stale":
        return _("Half paired, no bond: Linux would reject it")
    if d.get("state") == "disconnected":
        return _("Paired, not connected")
    return _("Not paired yet")


class PairDialog(Adw.Dialog):
    """Runs `mousetouch bt-pair ADDR` for a mouse picked in "Nearby mice" and
    shows its progress line by line. The daemon's helper drops whatever BlueZ
    knows about the mouse, waits for it to advertise, then pairs, trusts and
    connects, so the result is a bonded mouse even when it comes from a Mac."""

    def __init__(self, device: dict, on_done):
        super().__init__(title=_("Pairing…"), content_width=420, can_close=False)
        self.device = device
        self.on_done = on_done
        tb = Adw.ToolbarView()
        tb.add_top_bar(Adw.HeaderBar(show_end_title_buttons=False, show_start_title_buttons=False))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_start=24, margin_end=24, margin_top=12, margin_bottom=24)
        self.spinner = Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, width_request=32, height_request=32)
        box.append(self.spinner)
        self.icon = Gtk.Image(pixel_size=32, halign=Gtk.Align.CENTER, visible=False)
        box.append(self.icon)
        self.headline = Gtk.Label(label=_("Working…"), css_classes=["title-3"], wrap=True, justify=Gtk.Justification.CENTER)
        box.append(self.headline)
        self.detail = Gtk.Label(label=device.get("name") or device.get("addr", ""), css_classes=["dim-label"], wrap=True,
                                justify=Gtk.Justification.CENTER)
        box.append(self.detail)
        self.close_btn = Gtk.Button(label=_("Cancel"), halign=Gtk.Align.CENTER)
        self.close_btn.connect("clicked", self._cancel_or_close)
        box.append(self.close_btn)
        tb.set_content(box)
        self.set_child(tb)
        self.proc = None
        self.finished = False
        self.ok = False
        self.err_text = ""
        exe = mousetouch_binary()
        if not exe:
            self._finish(False, _("Could not run mousetouch: {error}").format(error="mousetouch not found in PATH"))
            return
        try:
            self.proc = Gio.Subprocess.new([exe, "bt-pair", device["addr"]], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as e:
            self._finish(False, _("Could not run mousetouch: {error}").format(error=e.message))
            return
        self.out = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self.err = Gio.DataInputStream.new(self.proc.get_stderr_pipe())
        self.out.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line)
        self.err.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_err_line)
        self.proc.wait_async(None, self._on_exit)

    def _on_line(self, stream, result):
        try:
            line, _len = stream.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:
            return
        kind, _sep, text = line.partition(":")
        text = text.strip()
        if kind == "hint":
            self.headline.set_label(_("Keep the mouse switched on; switch it off and on if nothing happens"))
        elif kind == "step":
            self.detail.set_label(text)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line)

    def _on_err_line(self, stream, result):
        try:
            line, _len = stream.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:
            return
        self.err_text = line.strip() or self.err_text
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_err_line)

    def _on_exit(self, proc, result):
        try:
            proc.wait_finish(result)
        except GLib.Error:
            pass
        ok = proc.get_if_exited() and proc.get_exit_status() == 0
        err = self.err_text.removeprefix("Error:").strip()
        self._finish(ok, "" if ok else _("Pairing failed: {error}").format(error=err or f"exit {proc.get_exit_status()}"))

    def _finish(self, ok: bool, message: str):
        self.finished = True
        self.ok = ok
        self.spinner.set_spinning(False)
        self.spinner.set_visible(False)
        self.icon.set_from_icon_name("emblem-ok-symbolic" if ok else "dialog-error-symbolic")
        self.icon.set_visible(True)
        self.headline.set_label(_("Connected and bonded") if ok else message)
        if ok:
            self.detail.set_label(self.device.get("name") or self.device.get("addr", ""))
        self.close_btn.set_label(_("Close"))
        self.set_can_close(True)

    def _cancel_or_close(self, *_a):
        if not self.finished and self.proc is not None:
            self.proc.force_exit()
            self.finished = True
        self.close()
        self.on_done(self.ok, self.device)


class NearbyMice(Adw.PreferencesGroup):
    """Mice that are switched on and not connected, from `mousetouch
    bt-scan`. "Connect" runs the daemon's pairing fix instead of the
    desktop's Bluetooth panel: after a mouse was paired with a Mac the panel
    usually leaves it paired-but-not-bonded and bluetoothd rejects it."""

    def __init__(self, window):
        super().__init__(title=_("Nearby mice"),
                         description=_("Mice that are switched on and not connected yet. Connecting here removes any half-finished pairing (the usual state after a Mac) and pairs, trusts and connects the mouse itself."))
        self.window = window
        self.proc = None
        self.rows: list[Gtk.Widget] = []
        self.spinner = Gtk.Spinner()
        self.scan_label = Gtk.Label(label=_("Scan"))
        inner = Gtk.Box(spacing=6)
        inner.append(self.spinner)
        inner.append(self.scan_label)
        self.scan_btn = Gtk.Button(valign=Gtk.Align.CENTER)
        self.scan_btn.set_child(inner)
        self.scan_btn.connect("clicked", lambda *_a: self.scan())
        self.set_header_suffix(self.scan_btn)
        self.empty = Adw.ActionRow(title=_("Press Scan with the mouse switched on."))
        self.empty.add_css_class("dim-label")
        self.add(self.empty)
        self.rows.append(self.empty)
        # Look once when the window opens: a mouse coming back from a Mac is
        # the first thing a new user needs.
        GLib.idle_add(self.scan)

    def scan(self):
        if self.proc is not None:
            return False
        exe = mousetouch_binary()
        if not exe:
            self._show_empty(_("Could not run mousetouch: {error}").format(error="mousetouch not found in PATH"))
            return False
        self.spinner.start()
        self.scan_label.set_label(_("Scanning…"))
        self.scan_btn.set_sensitive(False)
        try:
            self.proc = Gio.Subprocess.new([exe, "bt-scan", "6"], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as e:
            self._scan_ui_idle()
            self._show_empty(_("Could not run mousetouch: {error}").format(error=e.message))
            return False
        self.proc.communicate_utf8_async(None, None, self._on_scan_done)
        return False

    def _scan_ui_idle(self):
        self.proc = None
        self.spinner.stop()
        self.scan_label.set_label(_("Scan"))
        self.scan_btn.set_sensitive(True)

    def _on_scan_done(self, proc, result):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(result)
        except GLib.Error:
            out = ""
        self._scan_ui_idle()
        devices = []
        for line in (out or "").splitlines():
            if line.startswith("{"):
                try:
                    devices.append(json.loads(line))
                except ValueError:
                    pass
        self._populate(devices)

    def _clear(self):
        for r in self.rows:
            self.remove(r)
        self.rows = []

    def _show_empty(self, text: str):
        self._clear()
        self.empty.set_title(text)
        self.add(self.empty)
        self.rows.append(self.empty)

    def _populate(self, devices: list[dict]):
        if not devices:
            self._show_empty(_("No mice found. Switch the mouse off and on so it advertises, then scan again."))
            return
        self._clear()
        for d in devices:
            subtitle = device_state_text(d)
            if d.get("rssi") is not None:
                subtitle += f" · {d['rssi']} dBm"
            row = Adw.ActionRow(title=d.get("name") or d.get("addr", "?"), subtitle=subtitle)
            row.add_prefix(Gtk.Image.new_from_icon_name("input-mouse-symbolic"))
            btn = Gtk.Button(label=_("Connect"), valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
            btn.connect("clicked", lambda _b, dev=d: self._confirm(dev))
            row.add_suffix(btn)
            self.add(row)
            self.rows.append(row)

    def _confirm(self, d: dict):
        name = d.get("name") or d.get("addr", "")
        dlg = Adw.AlertDialog(heading=_("Connect {name}?").format(name=name),
                              body=_("Any old pairing of this mouse is removed, then it is paired, trusted and connected. It takes about ten seconds; keep the mouse switched on."))
        dlg.add_response("cancel", _("Cancel"))
        dlg.add_response("connect", _("Connect"))
        dlg.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("connect")
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "connect" and PairDialog(d, self._on_paired).present(self.window))
        dlg.present(self.window)

    def _on_paired(self, ok: bool, d: dict):
        if ok:
            self.window.toast.add_toast(Adw.Toast(title=_("Connected: {name}").format(name=d.get("name") or d.get("addr", ""))))
        self.scan()


