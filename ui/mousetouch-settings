                         gen["suppress_scroll_from_fingers"], 0, 5, 1, 0, lambda v: self._set("general", "suppress_scroll_from_fingers", v)))
        dm = Adw.EntryRow(title=_("Device name contains"))
        dm.set_text(gen["device_match"])
        dm.connect("apply", lambda r: self._set("general", "device_match", r.get_text().strip() or "Magic Mouse"))
        dm.set_show_apply_button(True)
        grp.add(dm)
        page.add(grp)

        # Appearance: theme and language. "System" follows the desktop; an
        # explicit choice is remembered in ui.toml.
        grp = Adw.PreferencesGroup(title=_("Appearance"))
        grp.add(combo_row(_("Theme"), _("System: follow the desktop's light/dark setting"),
                          [("system", _("System")), ("light", _("Light")), ("dark", _("Dark"))], PREFS["theme"], self._set_theme))
        sys_code = system_lang()
        sys_label = next((f"{_('System language')} · {flag} {name}" for code, flag, name in LANGS if code == sys_code), _("System language"))
        lang_options = [("system", sys_label)] + [(code, f"{flag} {name}") for code, flag, name in LANGS]
        grp.add(combo_row(_("Language"), _("Follows your desktop language; pick one to override"), lang_options, PREFS["language"],
                          self._set_language, searchable=True))
        page.add(grp)

        grp = Adw.PreferencesGroup(title=_("Daemon"))
        self.status_row = Adw.ActionRow(title=_("Background service"))
        self.status_icon = Gtk.Image.new_from_icon_name("dialog-warning-symbolic")
        self.status_row.add_prefix(self.status_icon)
        restart = Gtk.Button(label=_("Restart"), valign=Gtk.Align.CENTER)
        restart.connect("clicked", self._restart)
        self.status_row.add_suffix(restart)
        grp.add(self.status_row)
        open_row = Adw.ActionRow(title=_("Config file"), subtitle=str(CONFIG_PATH), activatable=True)
        open_row.add_suffix(Gtk.Image.new_from_icon_name("document-open-symbolic"))
        open_row.connect("activated", lambda *_a: Gio.AppInfo.launch_default_for_uri(CONFIG_PATH.as_uri(), None))
        grp.add(open_row)
        reset_row = Adw.ActionRow(title=_("Reset to defaults"), subtitle=_("Put every setting back to the values MouseTouch ships with"))
        reset_btn = Gtk.Button(label=_("Reset…"), valign=Gtk.Align.CENTER, css_classes=["destructive-action"])
        reset_btn.connect("clicked", self._reset_defaults)
        reset_row.add_suffix(reset_btn)
        grp.add(reset_row)
        page.add(grp)

        # Support: one row that opens the hosted donate page in the browser.
        grp = Adw.PreferencesGroup(title=_("Support MouseTouch"))
        beer_row = Adw.ActionRow(title=_("Buy me a beer 🍺"), subtitle=_("Opens payments.3m4.net in your browser"), activatable=True)
        beer_row.add_suffix(Gtk.Image.new_from_icon_name("external-link-symbolic"))
        beer_row.connect("activated", lambda *_a: Gio.AppInfo.launch_default_for_uri(SUPPORT_URL, None))
        grp.add(beer_row)
        page.add(grp)
        self._refresh_status()
        self._status_timer = GLib.timeout_add_seconds(5, self._refresh_status)
        app.events.add_listener(self._on_daemon_event)
        self.connect("close-request", self._on_close)

    def _on_close(self, *_a):
        GLib.source_remove(self._status_timer)
        self.app.events.remove_listener(self._on_daemon_event)
        return False

    # -- upgrades --------------------------------------------------------
    def _on_daemon_event(self, ev: dict):
        if ev.get("t") == "hello":
            self.daemon_version = ev.get("version")
            self._check_versions()
        elif ev.get("t") == "disconnected":
            self.daemon_version = None

    def _check_versions(self):
        """Point out a newer install than this window (reopen it) or than
        the running daemon (restart it; it does so by itself under systemd)."""
        disk = installed_version()
        if disk and STARTUP_VERSION and disk != STARTUP_VERSION:
            self.banner.set_title(_("MouseTouch {new} is installed; this window still runs {old}.").format(new=disk, old=STARTUP_VERSION))
            self.banner.set_button_label(_("Reopen"))
            self._banner_action = "reopen"
        elif disk and self.daemon_version and self.daemon_version != disk:
            self.banner.set_title(_("MouseTouch {new} is installed but the daemon still runs {old}.").format(new=disk, old=self.daemon_version))
            self.banner.set_button_label(_("Restart daemon"))
            self._banner_action = "restart"
        else:
            self._banner_action = None
        self.banner.set_revealed(self._banner_action is not None)

    def _banner_clicked(self, *_a):
        if self._banner_action == "restart":
            self._restart()
        elif self._banner_action == "reopen":
            # Replace this process with a fresh one from the file on disk; a
            # second process would only activate this instance (single
            # instance app), so exec rather than spawn.
            script = os.path.abspath(sys.argv[0])
            os.execv(sys.executable, [sys.executable, script, *sys.argv[1:]])

    # -- reset -----------------------------------------------------------
    def _reset_defaults(self, *_a):
        """List what differs from the shipped defaults and ask before writing them."""
        diff = config_diff(self.cfg)
        if not diff:
            dlg = Adw.AlertDialog(heading=_("Already at the defaults"),
                                  body=_("Every setting already has the value MouseTouch ships with."))
            dlg.add_response("close", _("Close"))
            dlg.present(self)
            return
        dlg = Adw.AlertDialog(heading=_("Reset to defaults?"),
                              body=_("These settings will change:") if len(diff) > 1 else _("This setting will change:"))
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        for label, cur, dflt in diff:
            row = Adw.ActionRow(title=GLib.markup_escape_text(label))
            if "\n" in cur or "\n" in dflt:
                row.set_subtitle(GLib.markup_escape_text(f"{cur}\n→\n{dflt}"))
            else:
                row.set_subtitle(GLib.markup_escape_text(f"{cur}  →  {dflt}"))
            lst.append(row)
        scroller = Gtk.ScrolledWindow(propagate_natural_height=True, max_content_height=360,
                                      hscrollbar_policy=Gtk.PolicyType.NEVER, child=lst)
        dlg.set_extra_child(scroller)
        dlg.add_response("cancel", _("Cancel"))
        dlg.add_response("reset", _("Reset"))
        dlg.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")
        dlg.connect("response", self._on_reset_response)
        dlg.present(self)

    def _on_reset_response(self, _dlg, response):
        if response != "reset":
            return
        if self._save_id:
            GLib.source_remove(self._save_id)
            self._save_id = 0
        self.cfg = copy.deepcopy(DEFAULTS)
        try:
            save_config(self.cfg)
        except Exception as e:  # noqa: BLE001
            self.toast.add_toast(Adw.Toast(title=_("Could not save: {error}").format(error=e)))
            return
        new = self.app.rebuild_window(self)
        new.toast.add_toast(Adw.Toast(title=_("Settings reset to defaults")))

    # -- state -----------------------------------------------------------
    def _set_axis(self, value):
        self._set("workspace_swipe", "axis", value)
        self._refresh_axis_hints()

    def _refresh_axis_hints(self):
        self.axis_row.set_subtitle(axis_hint())
        self.direction_row.set_subtitle(direction_hint(effective_axis(self.cfg["workspace_swipe"].get("axis", "auto"))))

    def _on_desktop_event(self, ev: dict):
        if ev.get("t") == "desktop":
            self._refresh_axis_hints()

    def _set(self, section, key, value):
        if value is None:
            self.cfg[section].pop(key, None)
        else:
            self.cfg[section][key] = value
        self._schedule_save()

    def _schedule_save(self):
        if self._save_id:
            GLib.source_remove(self._save_id)
        self._save_id = GLib.timeout_add(400, self._do_save)

    def _do_save(self):
        self._save_id = 0
        try:
            save_config(self.cfg)
        except Exception as e:  # noqa: BLE001
            self.toast.add_toast(Adw.Toast(title=_("Could not save: {error}").format(error=e)))
        return False

    # -- appearance ------------------------------------------------------
    def _set_theme(self, theme):
        if theme == PREFS["theme"]:
            return
        PREFS["theme"] = theme
        apply_theme(theme)
        self._save_prefs()

    def _set_language(self, code):
        global LANG
        if code == PREFS["language"]:
            return
        PREFS["language"] = code
        LANG = system_lang() if code == "system" else code
        self._save_prefs()
        # Every label comes from _(), so the simplest way to relabel is to
        # rebuild the window (unsaved config edits are flushed first).
        if self._save_id:
            GLib.source_remove(self._save_id)
            self._do_save()
        self.app.rebuild_window(self)

    def _save_prefs(self):
        try:
            save_ui_prefs(PREFS)
        except Exception as e:  # noqa: BLE001
            self.toast.add_toast(Adw.Toast(title=_("Could not save: {error}").format(error=e)))

    # -- gestures --------------------------------------------------------
    def _rebuild_gestures(self):
        for r in self.gest_rows:
            self.gest_group.remove(r)
        self.gest_rows = []
        for i, g in enumerate(self.cfg["gesture"]):
            row = Adw.ActionRow(title=describe_gesture(g), subtitle=describe_action(g["action"]), activatable=True)
            sw = Gtk.Switch(active=bool(g.get("enabled", True)), valign=Gtk.Align.CENTER)
            sw.connect("notify::active", lambda s, _p, idx=i: self._toggle_gesture(idx, s.get_active()))
            row.add_suffix(sw)
            rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"])
            rm.connect("clicked", lambda _b, idx=i: self._remove_gesture(idx))
            row.add_suffix(rm)
            row.connect("activated", lambda _r, idx=i: self._edit_gesture(idx))
            self.gest_group.add(row)
            self.gest_rows.append(row)
        if not self.cfg["gesture"]:
            row = Adw.ActionRow(title=_("No gestures yet"), subtitle=_("Use + to add one"))
            self.gest_group.add(row)
            self.gest_rows.append(row)

    def _toggle_gesture(self, idx, on):
        self.cfg["gesture"][idx]["enabled"] = on
        self._schedule_save()

    def _remove_gesture(self, idx):
        del self.cfg["gesture"][idx]
        self._rebuild_gestures()
        self._schedule_save()

    def _edit_gesture(self, idx):
        existing = self.cfg["gesture"][idx] if idx is not None else None

        def done(g):
            if idx is None:
                self.cfg["gesture"].append(g)
            else:
                self.cfg["gesture"][idx] = g
            self._rebuild_gestures()
            self._schedule_save()

        GestureDialog(existing, done).present(self)

    # -- daemon ----------------------------------------------------------
    def _refresh_status(self):
        unit, state, ok = service_status()
        self.status_row.set_subtitle(f"{unit}: {state}")
        self.status_icon.set_from_icon_name("emblem-ok-symbolic" if ok else "dialog-warning-symbolic")
        self._check_versions()
        return True

    def _restart(self, *_a):
        subprocess.run(["systemctl", "--user", "restart", service_unit()], check=False)
        GLib.timeout_add(800, self._refresh_status)
        self.toast.add_toast(Adw.Toast(title=_("Service restarted")))


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        # Wayland picks the icon from the .desktop file matching APP_ID; this
        # covers X11/XWayland and a launch from a terminal.
        Gtk.Window.set_default_icon_name(APP_ID)
        self.events = EventClient()
        self.live = None

    def open_live(self):
        if self.live is None:
            self.live = LiveWindow(self, self.events)
            self.live.connect("close-request", self._live_closed)
        self.live.present()

    def _live_closed(self, *_a):
        self.live = None
        return False

    def do_activate(self):
        apply_theme(PREFS["theme"])
        win = self.props.active_window or Window(self)
        win.present()

    def rebuild_window(self, old: Window) -> Window:
        """Replace the window after a language change or a reset (same size)."""
        w, h = old.get_default_size()
        new = Window(self)
        new.set_default_size(w, h)
        new.present()
        old.close()
        return new


if __name__ == "__main__":
    STARTUP_VERSION = installed_version()
    sys.exit(App().run(sys.argv))
