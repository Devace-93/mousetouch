def setting_choices() -> dict:
    """Stored value -> label for the settings shown as a drop-down."""
    return {
        ("workspace_swipe", "direction"): {"natural": _("Natural"), "inverted": _("Inverted")},
        ("workspace_swipe", "synthetic_fingers"): {None: _("Auto-detect"), 4: _("4 (COSMIC, KDE)"), 3: _("3 (GNOME)")},
        ("workspace_swipe", "axis"): {"auto": _("Auto-detect"), "horizontal": _("Horizontal"), "vertical": _("Vertical"), "both": _("Both")},
        ("workspace_swipe", "compositor_natural_scroll"): {None: _("Auto-detect"), True: _("On"), False: _("Off")},
        ("scroll", "mode"): {"notches": _("Whole notches"), "smooth": _("Smooth steps")},
    }


def format_setting(section: str, key: str, value) -> str:
    choices = setting_choices().get((section, key))
    if choices is not None and value in choices:
        return choices[value]
    if value is None:
        return "—"
    if isinstance(value, bool):
        return _("On") if value else _("Off")
    if isinstance(value, float):
        return f"{value:g}"
    return str(value)


def gestures_text(gestures: list) -> str:
    if not gestures:
        return _("No gestures yet")
    return "\n".join(f"{describe_gesture(g)} — {describe_action(g['action'])}" for g in gestures)


def config_diff(cfg: dict) -> list:
    """What a reset would change: (label, current text, default text) per setting,
    in the order the window shows them; the gesture list counts as one entry."""
    labels = setting_labels()
    out = []
    for section in ("workspace_swipe", "pinch", "scroll", "taps", "general"):
        defaults = DEFAULTS[section]
        current = cfg.get(section, {})
        for key in list(defaults) + [k for k in current if k not in defaults]:
            cur, dflt = current.get(key), defaults.get(key)
            if cur == dflt:
                continue
            group, title = labels.get((section, key), (section, key))
            out.append((f"{group} · {title}", format_setting(section, key, cur), format_setting(section, key, dflt)))
    if cfg.get("gesture", []) != DEFAULTS["gesture"]:
        out.append((_("Gestures"), gestures_text(cfg.get("gesture", [])), gestures_text(DEFAULTS["gesture"])))
    return out


def describe_gesture(g: dict) -> str:
    kind = dict(KINDS()).get(g["kind"], g["kind"])
    n = int(g["fingers"])
    s = (_("{kind} · {n} finger") if n == 1 else _("{kind} · {n} fingers")).format(kind=kind, n=n)
    if g["kind"] == "swipe" and g.get("direction"):
        s += " · " + dict(DIRS()).get(g["direction"], g["direction"])
    if g.get("app"):
        s += " · " + _("only in {app}").format(app=g["app"])
    return s


def _unit_state(unit: str) -> str:
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", unit], capture_output=True, text=True, timeout=3)
        return r.stdout.strip() or "unknown"
    except Exception:  # noqa: BLE001
        return "unknown"


def service_unit() -> str:
    """The unit the daemon runs under: the first candidate that is active,
    else a Homebrew unit that exists, else the packaged one."""
    states = {unit: _unit_state(unit) for unit in SERVICE_CANDIDATES}
    for unit, state in states.items():
        if state == "active":
            return unit
    user_units = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "systemd" / "user"
    for unit in SERVICE_CANDIDATES[1:]:
        if (user_units / unit).exists():
            return unit
    return SERVICE


def service_status() -> tuple[str, str, bool]:
    unit = service_unit()
    state = _unit_state(unit)
    return unit, state, state == "active"


